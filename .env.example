# Set to the public production origin in Vercel.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: homepage likes and guestbook.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret; never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: guestbook administrator public IP.
ALLOWED_GUESTBOOK_IP=

# Optional: Umami analytics. Speed Insights does not require these values.
NEXT_PUBLIC_DEPLOY_ENV=production
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
