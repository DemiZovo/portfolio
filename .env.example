# Set to the public production origin in Vercel.
NEXT_PUBLIC_SITE_URL=https://example.com

# Enable only after importing Markdown and configuring the owner account.
# markdown (default) or supabase; see EDITOR_SETUP.md.
CONTENT_SOURCE=markdown

# Server-only GitHub contents write token. Run supabase-github-sync.sql first.
WRITER_GITHUB_TOKEN=
WRITER_GITHUB_REPOSITORY=OWNER/REPOSITORY
WRITER_GITHUB_BRANCH=main

# Optional: homepage likes and guestbook.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret; never use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Optional fallback for legacy service-role keys.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: guestbook administrator public IP.
ALLOWED_GUESTBOOK_IP=

# Optional: Umami analytics. Speed Insights does not require these values.
NEXT_PUBLIC_DEPLOY_ENV=production
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
